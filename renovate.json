{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlertsWithLabel(\"security\")"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "groupName": "talos/vps updates (manual only)",
      "matchFileNames": ["stacks/talos/**", "stacks/vps/**"],
      "automerge": false
    },
    {
      "groupName": "platform/apps non-major updates",
      "matchFileNames": ["stacks/platform/**", "stacks/apps/**"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "groupName": "platform/apps access-chain (manual until rollout safety lands)",
      "matchFileNames": [
        "stacks/platform/traefik.ts",
        "stacks/platform/authelia/**",
        "stacks/platform/metallb.ts",
        "stacks/platform/netbird/**",
        "stacks/platform/cert-manager.ts",
        "stacks/platform/crowdsec/**",
        "stacks/apps/dns.ts"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["/^lib/version-pins\\.json$/"],
      "matchStrings": [
        "$each(helm, function($v, $k) { {\"depName\": $v.chart, \"currentValue\": $v.version, \"registryUrl\": $v.registryUrl} })"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["/^lib/version-pins\\.json$/"],
      "matchStrings": [
        "$each(docker, function($v, $k) { {\"depName\": $v.image, \"currentValue\": $v.tag} })"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["/^lib/version-pins\\.json$/"],
      "matchStrings": [
        "$each(go, function($v, $k) { {\"depName\": $v.moduleName, \"currentValue\": $v.version} })"
      ],
      "datasourceTemplate": "go"
    }
  ]
}
