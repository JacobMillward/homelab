{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlertsWithLabel(\"security\")"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "groupName": "talos/vps updates (manual only)",
      "matchFileNames": ["stacks/talos/**", "stacks/vps/**"],
      "automerge": false
    },
    {
      "groupName": "platform/apps non-major updates",
      "matchFileNames": ["stacks/platform/**", "stacks/apps/**"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "groupName": "platform/apps access-chain (manual until rollout safety lands)",
      "matchFileNames": [
        "stacks/platform/traefik.ts",
        "stacks/platform/authelia/**",
        "stacks/platform/metallb.ts",
        "stacks/platform/netbird/**",
        "stacks/platform/cert-manager.ts",
        "stacks/platform/crowdsec/**",
        "stacks/apps/dns.ts"
      ],
      "automerge": false
    }
  ],
  "customManagers": []
}
