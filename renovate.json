{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlertsWithLabel(\"security\")"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "groupName": "talos/vps updates (manual only)",
      "matchFileNames": ["stacks/talos/**", "stacks/vps/**"],
      "automerge": false
    },
    {
      "groupName": "platform/apps non-major updates",
      "matchFileNames": ["stacks/platform/**", "stacks/apps/**"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "groupName": "platform/apps access-chain (manual until rollout safety lands)",
      "matchFileNames": [
        "stacks/platform/traefik.ts",
        "stacks/platform/authelia/**",
        "stacks/platform/metallb.ts",
        "stacks/platform/netbird/**",
        "stacks/platform/cert-manager.ts",
        "stacks/platform/crowdsec/**",
        "stacks/apps/dns.ts"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stacks/platform/cert-manager\\.ts$/"],
      "matchStrings": [
        "chart:\\s*\"(?<depName>[^\"]+)\",\\s*\\n\\s*version:\\s*\"(?<currentValue>[^\"]+)\"[\\s\\S]*?repo:\\s*\"(?<registryUrl>[^\"]+)\""
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stacks/platform/netbird/router\\.ts$/"],
      "matchStrings": ["image:\\s*\"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stacks/platform/traefik\\.ts$/"],
      "matchStrings": [
        "moduleName:\\s*\"(?<depName>[^\"]+)\",\\s*\\n\\s*version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "go"
    }
  ]
}
